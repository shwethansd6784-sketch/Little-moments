# ==============================================================================
# Little Moments – Environment Configuration
# ==============================================================================

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous API Key (safe for browser client)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# NOTE: If these variables are not provided, Little Moments runs in Local/Demo Mode
# with complete offline support, interactive sample gifts, and local password hashing.
